{
  "name": "aria",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:api": "pnpm --filter @aria/api start:dev",
    "dev:desktop": "pnpm --filter @aria/desktop dev",
    "build": "pnpm --recursive --sort run build",
    "typecheck": "pnpm --recursive --sort run typecheck",
    "lint": "pnpm --filter @aria/desktop lint",
    "test": "pnpm --recursive --sort --if-present run test",
    "test:electron": "pnpm --filter @aria/desktop build && pnpm --filter @aria/desktop test:electron"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.22.2"
  }
}
