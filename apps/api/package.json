{
  "name": "@aria/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "pnpm --filter @aria/shared build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @aria/shared build && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@aria/shared": "workspace:^",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "ai": "7.0.170",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "3.2.7"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
