{
  "name": "@aria/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "pnpm --filter @aria/shared build && node ./scripts/stage-api.cjs && node ./scripts/stage-computer.cjs && node ./scripts/ensure-electron.cjs && vite build",
    "dev": "node --experimental-strip-types ./scripts/dev.mts",
    "build": "pnpm --filter @aria/shared build && node ./scripts/stage-api.cjs && node ./scripts/stage-computer.cjs && tsc -p tsconfig.electron.json && vite build",
    "typecheck": "pnpm --filter @aria/shared build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "format:check": "prettier --check src electron tests *.json *.mts *.ts *.mjs"
  },
  "dependencies": {
    "@aria/shared": "workspace:^",
    "@dagrejs/dagre": "^3.1.3",
    "@huggingface/tokenizers": "^0.2.0",
    "@js-temporal/polyfill": "0.5.1",
    "@photostructure/tz-lookup": "^11.8.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vitejs/plugin-react": "^4.3.4",
    "@zip.js/zip.js": "^2.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "5.10.7",
    "electron-updater": "6.8.11",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "onnxruntime-web": "^1.31.1",
    "parse5": "^8.1.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "saxes": "^6.0.0",
    "semver": "7.8.6",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "7.8.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  }
}
