{
  "name": "@aria/desktop",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "pnpm --filter @aria/shared build && node ./scripts/stage-api.cjs && node ./scripts/ensure-electron.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "pnpm --filter @aria/shared build && node ./scripts/stage-api.cjs && tsc -p tsconfig.electron.json && vite build",
    "typecheck": "pnpm --filter @aria/shared build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "format:check": "prettier --check src electron tests *.json *.mts *.ts *.mjs"
  },
  "dependencies": {
    "@aria/shared": "workspace:^",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  }
}
